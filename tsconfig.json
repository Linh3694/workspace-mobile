{
  "compilerOptions": {
    "strict": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "@atoms": [
        "src/components/ui-v2/level-0-atoms"
      ],
      "@atoms/*": [
        "src/components/ui-v2/level-0-atoms/*"
      ],
      "@molecules": [
        "src/components/ui-v2/level-1-molecules"
      ],
      "@molecules/*": [
        "src/components/ui-v2/level-1-molecules/*"
      ],
      "@organisms": [
        "src/components/ui-v2/level-2-organisms"
      ],
      "@organisms/*": [
        "src/components/ui-v2/level-2-organisms/*"
      ],
      "@templates": [
        "src/components/ui-v2/level-3-templates"
      ],
      "@templates/*": [
        "src/components/ui-v2/level-3-templates/*"
      ]
    },
    "moduleResolution": "bundler",
    "allowJs": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "module": "esnext",
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "types/**/*.d.ts",
    "src/@types/**/*.d.ts",
    "../workspace-frontend/src/pages/Student/HallOfHonor/HallOfHonorPage.tsx",
    "../workspace-frontend/src/pages/Student/HallOfHonor/RecordManager.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
