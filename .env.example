# Environment Configuration Template — Admin Mobile (Expo)
# Copy sang .env. KHÔNG commit file thật.
#
# GD0-01: file này được commit → chỉ đặt placeholder, không bao giờ đặt giá trị thật.
# Lưu ý Expo: mọi biến EXPO_PUBLIC_* được nhúng thẳng vào bundle → KHÔNG đặt secret ở đây.

# Môi trường: staging | production. Để TRỐNG là đủ cho hầu hết trường hợp:
# các script npm (android / android:staging / ios / ios:staging / start:staging / start:prod)
# và profile EAS đã tự set biến này. Không set gì thì dev → staging, bản release → production.
EXPO_PUBLIC_APP_ENV=

# Backend Frappe — chỉ set 2 biến dưới khi cần GHI ĐÈ mapping theo APP_ENV
# (máy local, ngrok…). Lưu ý: biến trong .env KHÔNG đè được biến inline của script npm.
EXPO_PUBLIC_BASE_URL=https://your-api-domain.com
EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.com
EXPO_PUBLIC_FRAPPE_SITE_NAME=your-site-name

# Microservice
EXPO_PUBLIC_NOTIFICATION_API_BASE_URL=https://your-api-domain.com
EXPO_PUBLIC_AI_BACKEND_URL=https://your-api-domain.com/api/ai

# Ghi song song device token sang backend mới (chuyển đổi) — true/false
EXPO_PUBLIC_DEVICE_TOKEN_DUAL_WRITE=false

# Kiểm tra cập nhật app — xem docs/app-update-remote-config.md
EXPO_PUBLIC_APP_UPDATE_CHECK=true
EXPO_PUBLIC_APP_UPDATE_CHECK_IN_DEV=false

# ĐỂ TRỐNG ở mọi build thật. Bỏ trống thì app tự đọc chính sách ở
# {API_BASE}/files/app-update-wis.json. Chỉ set khi cần trỏ máy test sang file khác.
# EXPO_PUBLIC_APP_UPDATE_CONFIG_URL=https://your-api-domain.com/files/app-update-wis.json

# MẶC ĐỊNH lúc build, chỉ dùng khi máy chủ không trả được chính sách:
#   false (đang chốt) = chỉ nhắc, vẫn có nút "Để sau"   |   true = mọi bản mới đều bắt buộc
# Remote config `force` ghi đè được cả hai chiều lúc chạy. Giá trị thật cho build nằm ở eas.json.
EXPO_PUBLIC_APP_UPDATE_FORCE=false

# ─────────────────────────────────────────────────────────────────────────────
# Azure/Entra ID hiện đang nằm trong app.json → expo.extra (azureClientId,
# azureTenantId, redirectUri). Sẽ chuyển sang app.config.ts per-tenant ở GĐ3-E.
# ─────────────────────────────────────────────────────────────────────────────
