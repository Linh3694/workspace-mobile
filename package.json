{
  "name": "wis-mobile",
  "version": "1.5.51",
  "scripts": {
    "android": "npm run copy-firebase && rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://prod.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://prod.sis.wellspring.edu.vn expo run:android",
    "android:staging": "npm run copy-firebase && rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_BASE_URL=https://admin.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://admin.sis.wellspring.edu.vn expo run:android",
    "ios": "rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://prod.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://prod.sis.wellspring.edu.vn expo run:ios",
    "ios:staging": "rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_BASE_URL=https://admin.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://admin.sis.wellspring.edu.vn expo run:ios",
    "start": "expo start",
    "start:staging": "rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_BASE_URL=https://admin.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://admin.sis.wellspring.edu.vn expo start",
    "start:prod": "rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://prod.sis.wellspring.edu.vn EXPO_PUBLIC_BASE_URL=https://prod.sis.wellspring.edu.vn expo start",
    "prebuild": "expo prebuild && npm run copy-firebase",
    "copy-firebase": "bash ./scripts/copy-firebase-config.sh",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "deploy": "./scripts/deploy.sh",
    "deploy:android": "./scripts/deploy.sh android",
    "deploy:ios": "./scripts/deploy.sh ios",
    "deploy:submit": "./scripts/deploy.sh all true",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile production-apk",
    "build:ios": "eas build --platform ios --profile production",
    "build:android:staging": "eas build --platform android --profile staging",
    "build:ios:staging": "eas build --platform ios --profile staging",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "release:android": "./scripts/build-android.sh",
    "release:android:build-only": "./scripts/build-android.sh --no-submit",
    "release:ios": "./scripts/build-ios.sh",
    "release:ios:build-only": "./scripts/build-ios.sh --no-submit",
    "release:both": "./scripts/release-both.sh",
    "release:both:build-only": "./scripts/release-both.sh --no-submit",
    "clean-all": "rm -rf node_modules && npm install && expo start --clear",
    "check-apple-signin": "node scripts/check-apple-signin.js",
    "generate-icons": "node scripts/generate-app-icons.js",
    "brand-lint": "node tools/brand-lint/brand-lint.mjs",
    "brand-lint:count": "node tools/brand-lint/brand-lint.mjs --mode=count",
    "brand-lint:full": "node tools/brand-lint/brand-lint.mjs --mode=full",
    "release:local": "./scripts/release-local.sh",
    "release:local:build-only": "./scripts/release-local.sh --no-submit",
    "release:local:ios": "./scripts/release-local.sh --only ios",
    "release:local:android": "./scripts/release-local.sh --only android",
    "setup:local-build": "./scripts/setup-local-build.sh"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.6.0",
